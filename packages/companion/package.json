{
  "name": "@trace/companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "trace-companion": "dist/main.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/**/*.test.js",
    "bench": "npm run build && node dist/scanner.bench.js",
    "bench:lenses": "npm run build && node dist/lens-counts.bench.js",
    "dev": "node --watch --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@trace/contracts": "0.1.0",
    "php-parser": "^3.2.5",
    "zod": "^4.1.12"
  }
}
