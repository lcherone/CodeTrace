{
  "name": "trace-vscode",
  "displayName": "Trace",
  "description": "Explore PHP symbol origins, callers, consumers, and history.",
  "version": "0.1.1",
  "publisher": "trace-dev",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lcherone/CodeTrace.git",
    "directory": "packages/extension"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "php",
    "composer",
    "code graph",
    "history",
    "dependencies"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:php",
    "onCommand:trace.openTrace",
    "onCommand:trace.openCompanion"
  ],
  "contributes": {
    "commands": [
      {
        "command": "trace.openTrace",
        "title": "Trace: Open Trace",
        "icon": "$(references)"
      },
      {
        "command": "trace.exploreSelectedSymbol",
        "title": "Trace: Explore Selected Symbol",
        "icon": "$(references)"
      },
      {
        "command": "trace.showParentImplementation",
        "title": "Trace: Show Parent Implementation"
      },
      {
        "command": "trace.showOverrides",
        "title": "Trace: Show Overrides"
      },
      {
        "command": "trace.findCallers",
        "title": "Trace: Find Callers"
      },
      {
        "command": "trace.findConsumerProjects",
        "title": "Trace: Find Consumer Projects"
      },
      {
        "command": "trace.showSymbolHistory",
        "title": "Trace: Show Symbol History"
      },
      {
        "command": "trace.refreshCurrentRepository",
        "title": "Trace: Refresh Current Repository"
      },
      {
        "command": "trace.openCompanion",
        "title": "Trace: Open Companion"
      },
      {
        "command": "trace.setClientToken",
        "title": "Trace: Set Companion Client Token"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "trace.exploreSelectedSymbol",
          "when": "editorLangId == php",
          "group": "navigation@20"
        }
      ],
      "commandPalette": [
        {
          "command": "trace.exploreSelectedSymbol",
          "when": "editorLangId == php"
        },
        {
          "command": "trace.showParentImplementation",
          "when": "editorLangId == php"
        },
        {
          "command": "trace.showOverrides",
          "when": "editorLangId == php"
        },
        {
          "command": "trace.findCallers",
          "when": "editorLangId == php"
        },
        {
          "command": "trace.findConsumerProjects",
          "when": "editorLangId == php"
        },
        {
          "command": "trace.showSymbolHistory",
          "when": "editorLangId == php"
        }
      ]
    },
    "configuration": {
      "title": "Trace",
      "properties": {
        "trace.companionUrl": {
          "type": "string",
          "default": "http://127.0.0.1:47173",
          "description": "Loopback URL of the Trace companion. Non-loopback URLs are rejected."
        },
        "trace.requestTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Companion request timeout in milliseconds."
        },
        "trace.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "Publish the active PHP editor path, revision and cursor position to the connected local Trace companion. Source contents are never sent."
        },
        "trace.followDelayMs": {
          "type": "number",
          "default": 300,
          "minimum": 100,
          "maximum": 5000,
          "description": "Debounce delay before Trace follows the active PHP editor selection."
        },
        "trace.autoScanWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Automatically discover and queue local Git repositories containing workspace PHP or Composer projects."
        },
        "trace.scanDiscoveryDelayMs": {
          "type": "number",
          "default": 800,
          "minimum": 0,
          "maximum": 30000,
          "description": "Debounce delay before automatic workspace and Composer project discovery."
        },
        "trace.scanChangeDelayMs": {
          "type": "number",
          "default": 1500,
          "minimum": 100,
          "maximum": 60000,
          "description": "Coalescing delay before a changed PHP or Composer file refreshes its repository index."
        },
        "trace.scanMaxComposerManifests": {
          "type": "number",
          "default": 250,
          "minimum": 1,
          "maximum": 5000,
          "description": "Maximum Composer manifests inspected during one workspace discovery pass. Discovery reports when this limit is reached."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "package": "npm run build && vsce package --no-dependencies",
    "clean": "rm -rf out"
  },
  "dependencies": {
    "@trace/contracts": "0.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6"
  }
}
